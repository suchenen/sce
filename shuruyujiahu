/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
UART_HandleTypeDef huart1;

/* USER CODE BEGIN PV */
static uint8_t  key_raw_last  = 1;   /* 上次采样到的原始电平 */
static uint8_t  key_stable    = 1;   /* 消抖后的稳定电平（1=松开） */
static uint32_t key_edge_tick = 0;   /* 最近一次"电平跳变"的时刻(ms) */

/* ---------- LED ---------- */
static uint8_t  mode      = 1;       /* 1=常亮 2=慢闪 3=快闪 */
static uint8_t  led_state = 1;       /* 1=点亮 0=熄灭 */
static uint32_t led_tick  = 0;
/* USER CODE END PV */

