/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  /* USER CODE BEGIN 2 */
  LOG_I("system ready, HCLK=%lu Hz", (unsigned long)HAL_RCC_GetHCLKFreq());
  printf("KEY + LED MODE TEST\r\n");
  printf("mode1\r\n");                    /* 上电默认 mode1：常亮 */

  key_edge_tick = HAL_GetTick();
  led_tick      = HAL_GetTick();
  HAL_GPIO_WritePin(LED_PORT, LED_PIN, LED_ON);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    uint32_t now = HAL_GetTick();
    uint8_t  raw = (uint8_t)HAL_GPIO_ReadPin(KEY_PORT, KEY_PIN);

    /* ================= 1. 时间戳消抖 ================= */
    if (raw != key_raw_last)
    {
        /* 电平刚发生变化 —— 可能是真实动作，也可能是抖动，
           先不判定，只把这一瞬间的时间戳记下来 */
        key_raw_last  = raw;
        key_edge_tick = now;             /* 抖动每跳一次就把时间戳重置一次 */
    }
    else if ((now - key_edge_tick) >= DEBOUNCE_MS && raw != key_stable)
    {
        /* 新电平已经稳定保持 20ms 没再变化 → 认定是真实动作 */
        key_stable = raw;

        if (key_stable == KEY_ACTIVE)    /* 稳定"按下" → 触发一次 */
        {
            mode++;
            if (mode > 3) mode = 1;      /* 三个模式循环 */
            printf("mode%d\r\n", mode);

            led_state = 1;               /* 切模式后从"亮"开始，观感一致 */
            led_tick  = now;
        }
    }

    /* ================= 2. 按模式驱动 LED ================= */
    switch (mode)
    {
      case 1:  /* 常亮 */
        HAL_GPIO_WritePin(LED_PORT, LED_PIN, LED_ON);
        break;

      case 2:  /* 慢闪 */
        if ((now - led_tick) >= SLOW_MS)
        {
            led_tick  = now;
            led_state = !led_state;
        }
        HAL_GPIO_WritePin(LED_PORT, LED_PIN, led_state ? LED_ON : LED_OFF);
        break;

      case 3:  /* 快闪 */
        if ((now - led_tick) >= FAST_MS)
        {
            led_tick  = now;
            led_state = !led_state;
        }
        HAL_GPIO_WritePin(LED_PORT, LED_PIN, led_state ? LED_ON : LED_OFF);
        break;

      default:
        mode = 1;
        break;
    }
  }
  /* USER CODE END 3 */
}

