#define KEY_PORT        GPIOB
#define KEY_PIN         GPIO_PIN_12
#define KEY_ACTIVE      0            /* 按下 = 低电平 */
#define DEBOUNCE_MS     20           /* 时间戳消抖窗口，20ms 覆盖绝大多数按键 */

#define LED_PORT        GPIOA
#define LED_PIN         GPIO_PIN_1
#define LED_ON          GPIO_PIN_SET     /* 高电平点亮（LED 正极经电阻接 PA1） */
#define LED_OFF         GPIO_PIN_RESET

#define SLOW_MS         500          /* 慢闪半周期 */
#define FAST_MS         100          /* 快闪半周期 */
/* USER CODE END PD */

